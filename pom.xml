<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.nablatensor</groupId>
  <artifactId>jax4j</artifactId>
  <version>0.2.0</version>
  <packaging>pom</packaging>
  <name>JAX4J</name>
  <description>Self-contained Java 25 tensor, autodiff and neural-network toolkit, migrated from the SonicTensor/NablaTensor lineage with TensorJIT CPU/autodiff sources.</description>
  <url>https://github.com/nablatensor-dev/jax4j</url>
  <licenses>
    <license>
      <name>The Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.3</junit.version>
  </properties>
  <dependencyManagement><dependencies>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
    <dependency><groupId>com.nablatensor</groupId><artifactId>jax4j-core</artifactId><version>${project.version}</version></dependency>
  </dependencies></dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
          <configuration><argLine>--enable-native-access=ALL-UNNAMED</argLine></configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <modules><module>jax4j-core</module><module>jax4j-engine-vulkan</module><module>jax4j-engine-wgpu</module></modules>
  <profiles>
    <profile><id>cuda</id><modules><module>jax4j-engine-cuda</module></modules></profile>
    <profile><id>rocm</id><modules><module>jax4j-engine-rocm</module></modules></profile>
    <profile><id>examples</id><modules><module>jax4j-examples</module></modules></profile>
    <profile><id>simd</id><modules><module>jax4j-simd</module></modules></profile>
  </profiles>
</project>
